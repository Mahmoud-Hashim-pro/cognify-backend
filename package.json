    "firebase": "^12.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "qs": "^6.16.0"
  }
